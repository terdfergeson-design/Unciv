<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The client talks to the bridge over a socket on 127.0.0.1, which needs this even for loopback -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application>
        <!-- Godot Android plugin v2: Engine.get_singleton("UncivBridge") in GDScript -->
        <meta-data
            android:name="org.godotengine.plugin.v2.UncivBridge"
            android:value="com.unciv.bridge.android.UncivBridgePlugin" />
    </application>
</manifest>
